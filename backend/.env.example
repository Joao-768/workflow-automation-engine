# Copy to backend/.env and adjust. Every variable is validated at startup
# (src/config/env.ts); the process exits with a clear message if one is wrong.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL. Matches docker-compose.yml; use your own URL for a local install.
DATABASE_URL=postgresql://workflow:workflow@localhost:5432/workflow_automation_engine
# true for managed Postgres (Render, Supabase); false locally.
DATABASE_SSL=false

# Redis for BullMQ. Must use maxmemory-policy noeviction.
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=wae

# At least 32 random characters in production:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API from a browser.
FRONTEND_URL=http://localhost:5173

# Worker
WORKER_CONCURRENCY=5
# First retry waits this long, then doubles: 2s, 4s, 8s...
RETRY_BACKOFF_MS=2000
# Hard limit for any single node.
NODE_TIMEOUT_MS=30000

# HTTP Request node. Private/loopback targets are blocked unless this is true.
# Turn it on locally if you want to call services on localhost.
HTTP_ALLOW_PRIVATE_NETWORKS=false
HTTP_MAX_RESPONSE_BYTES=1000000

# Email node. Leave SMTP_HOST empty to simulate delivery (recorded in the trace).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Workflow Engine <no-reply@example.com>
